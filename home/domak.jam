				{
					"id": "ch1pg21",
					"pubDate": "2026-06-20T17:08:41",
					"page_type": "paginated",
					"page_length": 1,
					"thumbnail": "comic/ch1/ch1pg21/ch1pg21_thumb.jpg",
					"title": {
						"en": "",
